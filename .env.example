# Base URL of the PHP API. In development the Vite dev server proxies /api to http://localhost:8000.
# On Vercel, keep /api and add a rewrite to the backend (see README → Deploying to Vercel), or set the backend URL here.
VITE_API_BASE_URL=/api

# true = use the in-browser mock API (src/api/mock.js) instead of the real backend
VITE_API_MOCK=true

# Cloudinary cloud name used by CloudinaryImage (leave empty to show placeholder gradients)
VITE_CLOUDINARY_CLOUD_NAME=

# Cloudflare Turnstile site key (public). Empty = no captcha widget. Turn it on only after Samin says the backend is
# ready; he then sets CAPTCHA_ENABLED=true. Test keys: 1x00000000000000000000AA always passes,
# 2x00000000000000000000AB always fails (to see the error state), 3x00000000000000000000FF shows a challenge.
VITE_TURNSTILE_SITE_KEY=

# Public site URL, used for canonical links and SEO
VITE_SITE_URL=https://rifaint.com
