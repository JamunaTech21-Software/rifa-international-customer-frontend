# Base URL of the PHP API. In development the Vite dev server proxies /api to http://localhost:8000.
VITE_API_BASE_URL=/api

# true = use the in-browser mock API (src/api/mock.js) instead of the real backend
VITE_API_MOCK=true

# Cloudinary cloud name used by CloudinaryImage (leave empty to show placeholder gradients)
VITE_CLOUDINARY_CLOUD_NAME=

# Public site URL, used for canonical links and SEO
VITE_SITE_URL=https://rifaint.com
