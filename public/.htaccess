# SPA fallback for cPanel / Apache: serve index.html for any route that is not a real file or folder.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Leave API requests to the backend
  RewriteRule ^api/ - [L]

  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  RewriteRule ^ index.html [L]
</IfModule>

# Long cache for hashed build assets, no cache for the HTML shell
<IfModule mod_headers.c>
  <FilesMatch "\.(js|css|woff2|svg|png|jpg|jpeg|webp)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "index\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>
